<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% block title %}Oozedle{% endblock %}</title>
  <meta name="description" content="{% block description %}Guess the Ooze player from one tournament stat line. New puzzle every day.{% endblock %}">
  <meta name="theme-color" content="#f7f6ee">
  <link rel="icon" href="{{ asset('favicon.svg') }}" type="image/svg+xml">
  <link rel="apple-touch-icon" href="{{ asset('apple-touch-icon.png') }}">
  <link rel="canonical" href="{{ page_url }}">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Oozedle">
  <meta property="og:title" content="{{ self.title() }}">
  <meta property="og:description" content="{{ self.description() }}">
  <meta property="og:url" content="{{ page_url }}">
  <meta property="og:image" content="{{ absolute_asset('og/card.png') }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="Oozedle: a guess board with arrows beside the wordmark">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="preload" href="{{ asset('fonts/cossette-titre-700.woff2') }}" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="{{ asset('css/site.css') }}">
  {% block head %}{% endblock %}
</head>
<body>
  <header class="topbar">
    <div class="topbar__inner">
      <a class="wordmark" href="{{ root }}index.html">OOZEDLE</a>
      <nav class="topnav" aria-label="Site">
        <a href="{{ root }}players.html"{% if nav == "players" %} aria-current="page"{% endif %}>Players</a>
        <a href="{{ root }}tournaments.html"{% if nav == "tournaments" %} aria-current="page"{% endif %}>Tournaments</a>
        <a href="{{ root }}advanced.html"{% if nav == "advanced" %} aria-current="page"{% endif %}>Advanced</a>
      </nav>
    </div>
  </header>
  <main id="main"{% block main_attrs %}{% block main_class %}{% endblock %}{% endblock %}>
    {% block main %}{% endblock %}
  </main>
  {% block scripts %}{% endblock %}
</body>
</html>
