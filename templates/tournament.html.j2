{% extends "base.html.j2" %}
{% from "ledger.html.j2" import stats, headers, score, view_switch, view_headers, view_cells %}
{% set nav = "tournaments" %}
{% block title %}{{ tournament.name }} {{ tournament.season }} · Oozedle{% endblock %}
{% block description %}{{ tournament.season }} · {{ tournament.games }} games · {{ tournament.wins }}–{{ tournament.losses }}{% endblock %}
{% block main_class %} class="wide"{% endblock %}
{% block main %}
<h1 class="page-head">{{ tournament.name }}</h1>
<p class="fact-line">{{ tournament.season }} · {{ tournament.games }} games · {{ tournament.wins }}–{{ tournament.losses }}</p>
<div class="view-controls">{{ view_switch("tournament-box") }}</div>
<h2 class="ledger-title">Games</h2>
<div class="ledger-wrap"><table class="ledger ledger--numbered" data-view="box" data-shared-view><caption class="visually-hidden">Tournament games</caption><thead><tr><th scope="col">#</th><th scope="col">Opponent</th><th scope="col">Score</th><th scope="col" class="v-box">Blocks</th><th scope="col" class="v-box">Turns</th>{% if tournament.has_clean_holds %}<th scope="col" class="v-box">Holds</th>{% endif %}<th scope="col" class="v-adv">Opp. rating</th><th scope="col" class="v-adv">Factor</th></tr></thead><tbody>{% for g in tournament.games_list %}<tr><td>{{ g.index }}</td><th scope="row">{{ g.opponent_label }}</th><td>{{ score(g) }}</td><td class="v-box">{{ g.team_blocks if g.team_blocks is not none else '—' }}</td><td class="v-box">{{ g.team_turnovers if g.team_turnovers is not none else '—' }}</td>{% if tournament.has_clean_holds %}<td class="v-box">{{ g.clean_holds if g.clean_holds is not none else '—' }}</td>{% endif %}<td class="v-adv">{{ g.opponent_rating|statnum(0) }}</td><td class="v-adv">{{ '×' if g.factor is not none else '' }}{{ g.factor|statnum(2) }}</td></tr>{% endfor %}</tbody></table></div>
<h2 class="ledger-title">Box score</h2>
<div class="ledger-wrap"><table class="ledger ledger--tournament" data-sortable data-view="box" id="tournament-box"><caption class="visually-hidden">Player box score</caption>{{ view_headers() }}<tbody>{% for p in tournament.box %}<tr><th scope="row"><a href="{{ root }}players/{{ p.player_id }}.html">{{ p.name }}</a></th>{{ view_cells(p) }}</tr>{% endfor %}</tbody></table></div>
<nav class="tournament-nav" aria-label="Adjacent tournaments">{% for key, label in [('previous','Previous'), ('next','Next')] %}<span>{% if tournament[key] %}<a rel="{{ 'prev' if key == 'previous' else 'next' }}" href="{{ root }}tournaments/{{ tournament[key].tournament_id }}.html">{{ label }}: {{ tournament[key].name }}</a>{% endif %}</span>{% endfor %}</nav>
{% endblock %}
{% block scripts %}<script src="{{ asset('js/tables.js') }}" defer></script>{% endblock %}
