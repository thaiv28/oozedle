{% extends "base.html.j2" %}
{% from "ledger.html.j2" import headers %}
{% from "ranking_rows.html.j2" import table with context %}
{% set nav = "players" %}
{% block title %}Advanced · Oozedle{% endblock %}
{% block main_class %} class="wide"{% endblock %}
{% block main %}
<h1 class="page-head">Advanced</h1>
<h2 class="ledger-title">Margin added</h2>
<div class="ledger-wrap"><table class="ledger"><caption class="visually-hidden">Margin added weights</caption>{{ headers(['Stat', 'Goals of margin', '95% interval']) }}<tbody>
{% for label,index,scale in [('Assist',0,0.5),('Goal',0,0.5),('Block',1,1),('Turnover',2,1)] %}<tr><th scope="row">{{ label }}</th><td>{{ (model.scoring.coef[index] * scale)|statnum(2) }}</td><td>{{ (model.scoring.low[index] * scale)|statnum(2) }} to {{ (model.scoring.high[index] * scale)|statnum(2) }}</td></tr>{% endfor %}
</tbody></table></div>
<h2 class="ledger-title">Opponent adjustment</h2>
{% if ratings_available %}
<div class="ledger-wrap"><table class="ledger"><caption class="visually-hidden">Rating gap → Factor</caption>{{ headers(['Rating gap', 'Factor']) }}<tbody>{% for row in gap_factors %}<tr><th scope="row">{{ '+' if row.gap > 0 else '' }}{{ row.gap|statnum }}</th><td>×{{ row.factor|statnum(2) }}</td></tr>{% endfor %}</tbody></table></div>
<div class="ledger-wrap"><table class="ledger"><caption class="visually-hidden">Ooze's USAU college ratings</caption>{{ headers(['Season', 'Rating', 'Rank', 'Data through']) }}<tbody>{% for row in season_ratings %}<tr><th scope="row">{{ row.season }}</th><td>{{ row.rating|statnum(0) }}</td><td>{{ row.rank|statnum }}</td><td>{{ row.as_of }}</td></tr>{% endfor %}</tbody></table></div>
{% else %}<p class="fact-line">Ratings are unavailable. Adj. MA equals MA.</p>{% endif %}
<p class="rating-source">Ratings: Ultiworld Projected Rankings (formerly frisbee-rankings.com); past seasons from Internet Archive snapshots.</p>

<h2 class="ledger-title">Best tournament performances</h2>
{{ table('performances', best_performances, 'Ten best tournament performances by adjusted margin added') }}
<p class="quiet-link"><a href="{{ root }}advanced/performances.html">All tournament performances</a></p>
<h2 class="ledger-title">Best seasons</h2>
{{ table('seasons', best_seasons, 'Ten best seasons by adjusted margin added') }}
<p class="quiet-link"><a href="{{ root }}advanced/seasons.html">All seasons</a></p>
<h2 class="ledger-title">Best careers</h2>
{{ table('careers', best_careers, 'Ten best careers by adjusted margin added') }}
<p class="quiet-link"><a href="{{ root }}advanced/careers.html">All careers</a></p>
<h2 class="ledger-title">Best at each tournament</h2>
<div class="ledger-wrap"><table class="ledger ledger--performances"><caption class="visually-hidden">Best adjusted margin added at each tournament across seasons</caption>{{ headers(['Tournament','Player','Season','Adj. MA']) }}<tbody>{% for p in best_tournaments %}<tr><th scope="row">{{ p.tournament_name }}</th><td><a href="{{ root }}players/{{ p.player_id }}.html">{{ p.name }}</a></td><td>{{ p.season }}</td><td>{{ p.adj_ma|statnum(1) }}</td></tr>{% endfor %}</tbody></table></div>
{% endblock %}
