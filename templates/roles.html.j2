{% extends "base.html.j2" %}
{% from "ledger.html.j2" import headers %}
{% set nav = "players" %}
{% block title %}Roles · Oozedle{% endblock %}
{% block main_class %} class="wide"{% endblock %}
{% block main %}
<h1 class="page-head">Roles</h1>
<p>Each dot is a player's season: further right, more of their scoring plays are assists; higher, more blocks per point. Bigger dots played more points.</p>
<div class="players-controls">
<div class="view-switch" id="roles-switch" role="group" aria-label="Player totals"><button type="button" data-mode="seasons" aria-pressed="true">Seasons</button><button type="button" data-mode="careers" aria-pressed="false">Careers</button></div>
<label class="visually-hidden" for="roles-search">Find a player</label><input type="search" id="roles-search" placeholder="Find a player">
</div>
<div id="roles-chart" class="roles-chart"><div id="roles-tooltip" class="roles-tooltip" role="tooltip" hidden></div></div>
<p id="roles-status" class="quiet-link" role="status"></p>
<noscript><p>The chart needs JavaScript. All plotted seasons are listed below.</p></noscript>
<details class="model-details"><summary>Chart data</summary><div class="ledger-wrap"><table class="ledger ledger--roles"><caption class="visually-hidden">Plotted player totals</caption>{{ headers(['Player', 'Season', 'PP', 'Assist share', 'Blocks per point']) }}<tbody id="roles-rows">{% for p in roles_rows %}<tr><th scope="row"><a href="{{ root }}players/{{ p.player_id }}.html">{{ p.name }}</a></th><td>{{ p.season }}</td><td>{{ p.points_played|statnum }}</td><td>{{ (100 * p.assist_share)|statnum(0) }}%</td><td>{{ p.blocks_per_point|statnum(2) }}</td></tr>{% endfor %}</tbody></table></div></details>
{% endblock %}
{% block scripts %}<script type="application/json" id="roles-data">{{ roles_json|safe }}</script><script src="{{ asset('js/roles.js') }}" defer></script>{% endblock %}
