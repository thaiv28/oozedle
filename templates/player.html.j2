{% extends "base.html.j2" %}
{% from "ledger.html.j2" import stats, headers, score %}
{% set nav = "players" %}
{% block title %}{{ player.name }} · Oozedle{% endblock %}
{% block description %}{{ player.year_range }} · {{ player.career.tournaments }} tournaments · {{ player.career.games_played }} games · MA {{ player.career.ma|statnum(1) }}{% endblock %}
{% block main_class %} class="wide"{% endblock %}
{% block main %}
<h1 class="page-head">{{ player.name }}</h1>
<p class="fact-line">{{ player.year_range }} · {{ player.career.tournaments }} tournaments · {{ player.career.games_played }} games</p>
<h2 class="ledger-title">Career</h2>
<div class="ledger-wrap"><table class="ledger career"><caption class="visually-hidden">Career totals</caption>{{ headers(['PP', 'A', 'G', 'B', 'T', 'GP', 'W–L']) }}<tbody><tr>{{ stats(player.career) }}<td>{{ player.career.games_played }}</td><td>{{ player.career.wins }}–{{ player.career.losses }}</td></tr></tbody></table></div>
<h2 class="ledger-title">Seasons</h2>
<div class="ledger-wrap"><table class="ledger ledger--trim"><caption class="visually-hidden">Season totals</caption>{{ headers(['Season', 'Tourn.', 'GP', 'PP', 'A', 'G', 'B', 'T', 'W–L']) }}<tbody>{% for s in player.season_rows %}<tr><th scope="row">{{ s.season }}</th><td>{{ s.tournaments }}</td><td>{{ s.games_played }}</td>{{ stats(s) }}<td>{{ s.wins }}–{{ s.losses }}</td></tr>{% endfor %}</tbody></table></div>
<h2 class="ledger-title">Advanced</h2>
<div class="ledger-wrap"><table class="ledger ledger--advanced"><caption class="visually-hidden">Advanced career and season totals</caption>{{ headers(['', 'PP', 'MA', 'Adj. MA', 'Adj. MA per 10']) }}<tbody>
{% for s in [player.career] + player.season_rows %}<tr><th scope="row">{{ 'Career' if loop.first else s.season }}</th><td>{{ s.points_played|statnum }}</td><td>{{ s.ma|statnum(1) }}</td><td>{{ s.adj_ma|statnum(1) }}</td><td>{{ s.adj_ma_per10|statnum(1) }}</td></tr>{% endfor %}
</tbody></table></div>
{% if player.most_like %}<p class="fact-line">Plays most like: {% for p in player.most_like %}<a href="{{ root }}players/{{ p.player_id }}.html">{{ p.name }} · {{ p.season }}</a>{{ ', ' if not loop.last else '' }}{% endfor %}</p>{% endif %}
<p class="quiet-link"><a href="{{ root }}advanced.html">How MA works</a></p>
<h2 class="ledger-title">Tournaments</h2>
{% for t in player.tournament_rows %}
{% if t.games_list %}<details class="tournament-detail"><summary class="tournament-row">{% else %}<div class="tournament-row">{% endif %}
<span><a href="{{ root }}tournaments/{{ t.tournament_id }}.html">{{ t.name }}</a> · {{ t.season }}</span>
{% for key, label in [('points_played','PP'), ('assists','A'), ('goals','G'), ('blocks','B'), ('turnovers','T')] %}<span>{{ t[key] }} <small>{{ label }}</small></span>{% endfor %}
{% if t.games_list %}</summary><div class="ledger-wrap"><table class="ledger"><caption class="visually-hidden">{{ t.name }} games</caption>{{ headers(['Opponent', 'Score', 'PP', 'A', 'G', 'B', 'T']) }}<tbody>{% for g in t.games_list %}<tr><th scope="row">{{ g.opponent_label }}</th><td>{{ score(g) }}</td>{{ stats(g) }}</tr>{% endfor %}</tbody></table></div></details>{% else %}</div>{% endif %}
{% endfor %}
{% endblock %}
